# Environment variables read by the server and the desktop client.
#
# Everything here is optional: the normal setup is the TOML config files
# (copy server-config.example.toml / config.example.toml). An environment
# variable set to a non-empty value overrides the matching config-file setting.
#
# Nothing loads this file automatically. Copy it to .env (ignored by Git),
# uncomment what you need, and pass it in yourself, e.g.:
#   systemd:  EnvironmentFile=/path/to/.env   (in async-storage-bot.service)
#   docker:   docker run --env-file .env ...
#   bash:     set -a; . ./.env; set +a; python -m server

# --- Config file locations -------------------------------------------------
# Server config file. Default: ./server-config.toml (--config PATH wins).
# STORAGE_SERVER_CONFIG=./server-config.toml
# Desktop client config file. Default: ./config.toml
# STORAGE_CLIENT_CONFIG=./config.toml

# --- Server: [server] overrides --------------------------------------------
# Shared secret clients send in the X-API-Key header. At least 16 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This placeholder is rejected at startup on purpose.
# STORAGE_API_KEY=PASTE_A_LONG_RANDOM_KEY_HERE
# Files and manifest DB location. Default: ./data
# STORAGE_DATA_DIR=./data
# Bind address. Default: 127.0.0.1 (loopback only). Use your Tailscale/LAN IP
# to expose it there; avoid 0.0.0.0 unless every interface is trusted.
# STORAGE_HOST=127.0.0.1
# Bind port. Default: 8000
# STORAGE_PORT=8000
# Per-day log files (YYYY-MM-DD.log). Default: ./logs
# STORAGE_LOG_DIR=./logs

# --- Server: [limits] overrides --------------------------------------------
# Largest single upload, in bytes. Default: 10737418240 (10 GiB)
# STORAGE_MAX_FILE_BYTES=10737418240
# Uploads processed at once. Default: 4
# STORAGE_MAX_CONCURRENT_UPLOADS=4
# Total live storage across all files, in bytes. Default: 0 (unlimited)
# STORAGE_MAX_TOTAL_BYTES=0
# Seconds to wait for the next upload chunk before aborting. Default: 60
# STORAGE_UPLOAD_TIMEOUT=60
