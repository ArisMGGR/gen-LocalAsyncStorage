# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Secrets / local config. Only the *.example.toml templates are tracked;
# any other config file (custom --config / STORAGE_*_CONFIG names) stays local.
.env
.env.*
config*.toml
server-config*.toml
!*.example.toml
*.bak

# Runtime data (server data_dir, logs, manifest DB, partial transfers)
data/
logs/
*.db
*.db-journal
*.db-wal
*.db-shm
*.part

# PyInstaller output (see README, "Package the desktop app as an .exe")
build/
dist/
*.spec

# Android signing keys (build output is covered by android/.gitignore)
*.jks
*.keystore

# OS junk
.DS_Store
desktop.ini
Thumbs.db

# Windows shortcuts (install-client makes one on the desktop)
*.lnk

# Local audit reports
tests/FINDINGS.md
tests/LOG.md
tests/VERIFY.md
