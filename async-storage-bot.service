# systemd unit for the Async Storage DOS server ("async-storage-bot").
#
# Runs as your normal login user, like your other background bots
# (server_YtWatchlistbot, ...). All settings — the API key, host, port, and
# limits — are read from server-config.toml in the WorkingDirectory below.
#
# Install (see docs/setup-service.md for the full walkthrough):
#   sudo cp async-storage-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now async-storage-bot.service
#
# Edit the three "EDIT" lines below to match your setup.

[Unit]
Description=Async Storage DOS server (async-storage-bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# EDIT: your login username — the same account your other bots run as.
User=YOUR_USERNAME

# EDIT: the folder that contains the "server/" package (your checkout of this
# repo). The server automatically reads ./server-config.toml from here.
WorkingDirectory=/home/YOUR_USERNAME/Async_Storage_DOS

# EDIT: the Python that has this project's dependencies installed. Use the
# system python3, or a virtualenv's python, e.g.
#   ExecStart=/home/YOUR_USERNAME/Async_Storage_DOS/venv/bin/python -m server
ExecStart=/usr/bin/python3 -m server

# Restart the server if it crashes, with a short back-off.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
